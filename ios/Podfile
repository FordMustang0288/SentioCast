platform :ios, '12.4'
install! 'cocoapods', :deterministic_uuids => false

require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/react-native/node_modules/@react-native-community/cli-platform-ios/native_modules'

# React Native 0.75+ specific configuration
$RNNKotlinVersion = '1.8.0'

# Define the project root
project_root = '../'

# Define the node modules path
node_modules_path = '../node_modules'

# Define the React Native path
react_native_path = '../node_modules/react-native'

# Define the React Native scripts path
react_native_scripts_path = File.join(react_native_path, 'scripts')

# Define the React Native pods script
react_native_pods_script = File.join(react_native_scripts_path, 'react_native_pods.rb')

# Load the React Native pods
if File.exist?(react_native_pods_script)
  require react_native_pods_script
end

target 'VoicePodcastPlayer' do
  # React Native pods
  config = use_native_modules!
  
  # Use flags for React Native
  flags = get_default_flags()
  
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled]
  )
  
  # Add Flipper integration if needed
  # flipper_config = FlipperConfiguration.enabled
  # use_flipper!(flipper_config)
  
  target 'VoicePodcastPlayerTests' do
    inherit! :complete
  end
  
  # Post install hook
  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    # Additional post-install configurations
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.4'
      end
    end
  end
end
